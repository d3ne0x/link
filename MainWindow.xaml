<Window x:Class="Symbolic11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkCraft — Create • Manage • Simplify Links"
        Width="1180" Height="760" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F8FD"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1263D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#0C2444">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="24,27,0,0">
                <TextBlock Text="LINKCRAFT" Foreground="White" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="CREATE  •  MANAGE  •  SIMPLIFY" Foreground="#B6D0F4" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Button Content="Home" Style="{StaticResource SidebarButton}" Click="Home_Click"/>
                <Button Content="Create Link" Style="{StaticResource SidebarButton}" Click="Create_Click"/>
                <Button Content="Manage Links" Style="{StaticResource SidebarButton}" Click="Manage_Click"/>
                <Button Content="Settings" Style="{StaticResource SidebarButton}" Click="Settings_Click"/>
                <Button Content="About" Style="{StaticResource SidebarButton}" Click="About_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="LinkCraft  •  Phase 1 Preview" Foreground="#A8C4E9" Margin="25,0,0,22"/>
        </Grid>
        <Frame x:Name="Workspace" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#F5F8FD"/>
    </Grid>
</Window>