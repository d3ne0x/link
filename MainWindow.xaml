<Window x:Class="Symbolic11.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LinkCraft" Width="790" Height="415" MinWidth="760" MinHeight="400"
 WindowStartupLocation="CenterScreen" Background="#F8FBFE" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="TabButton" TargetType="Button">
   <Setter Property="Padding" Value="18,9"/><Setter Property="Background" Value="#F2F6FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#24374D"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#F7FAFD" BorderBrush="#DCE5EE" BorderThickness="0,0,0,1" Padding="23,7,0,0">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="CreateTab" Content="Create Link" Style="{StaticResource TabButton}" Click="Create_Click" FontWeight="SemiBold" Foreground="#0869EF"/>
    <Button x:Name="ManageTab" Content="Existing Links" Style="{StaticResource TabButton}" Click="Manage_Click" Margin="7,0,0,0"/>
   </StackPanel>
  </Border>
  <Frame x:Name="Workspace" Grid.Row="1" NavigationUIVisibility="Hidden" Background="#F8FBFE"/>
 </Grid>
</Window>