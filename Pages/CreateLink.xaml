<Page x:Class="Symbolic11.Pages.CreateLink"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="#F7F8FA" Title="Create Link">
 <Page.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#243244"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="35"/><Setter Property="Padding" Value="14,6"/></Style>
 </Page.Resources>
 <Grid Margin="32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Create a link" FontSize="25" FontWeight="SemiBold"/>
  <TextBlock x:Name="StepCaption" Grid.Row="1" Text="Step 1 of 4 — Link type" Foreground="#637084" Margin="0,7,0,24" FontSize="14"/>
  <Grid Grid.Row="2" Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ProgressOne" Grid.Column="0" Text="①  Link Type" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#0869EF"/>
   <TextBlock x:Name="ProgressTwo" Grid.Column="1" Text="②  Target" HorizontalAlignment="Center"/>
   <TextBlock x:Name="ProgressThree" Grid.Column="2" Text="③  Link Location" HorizontalAlignment="Center"/>
   <TextBlock x:Name="ProgressFour" Grid.Column="3" Text="④  Review &amp; Create" HorizontalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="8" Padding="24">
   <Grid>
    <StackPanel x:Name="StepOne">
     <TextBlock Text="Choose link type" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ComboBox x:Name="SymbolicType" Width="310" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="SymbolicType_SelectionChanged" Visibility="Collapsed">
      <ComboBoxItem Content="Symbolic Link"/>
      <ComboBoxItem x:Name="HardLink" Content="Hard Link" IsEnabled="False"/>
      <ComboBoxItem x:Name="JunctionLink" Content="Junction Link"/>
     </ComboBox>
     <UniformGrid Columns="3" Margin="0,4,0,16">
      <Button x:Name="SymbolicCard" Click="SymbolicCard_Click" Margin="0,0,10,0" MinHeight="175" Background="#EAF3FF" BorderBrush="#0869EF" BorderThickness="2">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="🔗" FontSize="32" HorizontalAlignment="Center"/>
        <TextBlock Text="Symbolic Link" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="File or folder" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Button>
      <Button x:Name="HardCard" Click="HardCard_Click" Margin="0,0,10,0" MinHeight="175" Background="#FFFFFF" BorderBrush="#DCE2E9">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="▤" FontSize="34" HorizontalAlignment="Center"/>
        <TextBlock Text="Hard Link" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="Files only" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Button>
      <Button x:Name="JunctionCard" Click="JunctionCard_Click" MinHeight="175" Background="#FFFFFF" BorderBrush="#DCE2E9">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="▱" FontSize="34" HorizontalAlignment="Center"/>
        <TextBlock Text="Junction" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="Folders only" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Button>
     </UniformGrid><TextBlock Text="Target kind" Margin="0,10,0,8" FontWeight="SemiBold"/>
     <ComboBox x:Name="FileType" Width="310" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="FileType_SelectionChanged" Visibility="Collapsed">
      <ComboBoxItem Content="Folder"/><ComboBoxItem Content="File"/>
     </ComboBox>
     <TextBlock Text="Choose the link type above. Symbolic links work with files or folders; hard links with files; junctions with folders." TextWrapping="Wrap" Foreground="#637084" Margin="0,20,0,0"/>
    </StackPanel>
    <StackPanel x:Name="StepTwo" Visibility="Collapsed">
     <TextBlock Text="Choose existing target" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Label x:Name="DestinationText" Content="Target Folder (existing)"/>
     <DockPanel>
      <Button x:Name="DestinationExplore" Content="Browse..." Click="DestinationExplore_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/>
      <TextBox x:Name="DestinationPath" IsReadOnly="False" TextChanged="WizardField_TextChanged"/>
     </DockPanel>
     <TextBlock Text="The target must already exist." Foreground="#637084" Margin="0,14,0,0"/>
    </StackPanel>
    <StackPanel x:Name="StepThree" Visibility="Collapsed">
     <TextBlock Text="Choose link location" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Label x:Name="LinkText" Content="Link Location (parent folder)"/>
     <DockPanel>
      <Button x:Name="LinkExplore" Content="Browse..." Click="LinkExplore_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/>
      <TextBox x:Name="LinkFolderPath" TextChanged="WizardField_TextChanged"/>
     </DockPanel>
     <TextBlock Text="Link name" Margin="0,20,0,8" FontWeight="SemiBold"/>
     <DockPanel>
      <Button x:Name="copyFileName" Content="Use target name" Click="useDestinationName" DockPanel.Dock="Right" Margin="10,0,0,0"/>
      <ui:TextBox x:Name="LinkName" PlaceholderText="Enter link name"/>
     </DockPanel>
    </StackPanel>
    <StackPanel x:Name="StepFour" Visibility="Collapsed">
     <TextBlock Text="Review and create" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock x:Name="ReviewText" TextWrapping="Wrap" FontSize="14" LineHeight="27"/>
     <TextBlock Text="The existing target will not be overwritten." Foreground="#637084" Margin="0,18,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <ui:InfoBar Grid.Row="4" x:Name="InfoBar" Title="" Message="" Margin="0,12,0,0" IsOpen="False"/>
  <DockPanel Grid.Row="5" Margin="0,18,0,0">
   <Button x:Name="WizardBack" Content="Back" Click="WizardBack_Click" IsEnabled="False" DockPanel.Dock="Left"/>
   <Button x:Name="CreateLinkButton" Content="Create Link" Click="CreateLink_Click" DockPanel.Dock="Right" Visibility="Collapsed"/>
   <Button x:Name="WizardNext" Content="Next" Click="WizardNext_Click" DockPanel.Dock="Right"/>
  </DockPanel>
 </Grid>
</Page>