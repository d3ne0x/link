<Page x:Class="Symbolic11.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F8FD" Title="Home">
    <Page.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="170"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Border Background="#0869EF" CornerRadius="14" Padding="28">
                <StackPanel>
                    <TextBlock Text="LinkCraft" FontSize="36" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Create • Manage • Simplify Links" FontSize="17" Foreground="#E3F0FF" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="What would you like to do?" FontSize="23" FontWeight="SemiBold" Foreground="#172B46" Margin="0,30,0,20"/>
            <UniformGrid Columns="3">
                <Button Background="#0869EF" Style="{StaticResource CardButton}" Click="Create_Click">
                    <StackPanel>
                        <TextBlock Text="Create Link  →" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Create symbolic links, hard links and junctions." FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Background="#08A984" Style="{StaticResource CardButton}" Click="Manage_Click">
                    <StackPanel>
                        <TextBlock Text="Manage Links  →" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Search, validate and safely manage links." FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Background="#7644D9" Style="{StaticResource CardButton}" Click="Settings_Click">
                    <StackPanel>
                        <TextBlock Text="Settings  →" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Configure application preferences." FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
            <TextBlock Text="Quick Overview" FontSize="23" FontWeight="SemiBold" Foreground="#172B46" Margin="0,32,0,14"/>
            <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#DCE5F1" BorderThickness="1">
                <TextBlock Text="Link counts will appear after folder scanning. No system-wide totals are assumed." Foreground="#61728C" FontSize="15" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>