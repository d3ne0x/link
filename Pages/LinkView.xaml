<Page x:Class="Symbolic11.Pages.LinkView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F7F8FA" Title="Existing Links">
 <Page.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="34"/></Style>
 </Page.Resources>
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Existing Links" FontSize="25" FontWeight="SemiBold" Foreground="#243244"/>
   <TextBlock Text="Select a folder to scan for links. Select a result to delete the link only." Foreground="#637084" Margin="0,6,0,16"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
   <TextBox x:Name="SearchPathText" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" MinHeight="34"/>
   <Button x:Name="changeSearchDirectory" Grid.Column="2" Content="Browse..." Click="changeSearchDirectory_Click" Margin="8,0"/>
   <Button x:Name="searchButton" Grid.Column="3" Content="Scan" Click="searchButton_Click" Background="#0869EF" Foreground="White" BorderThickness="0"/>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="8">
   <DataGrid x:Name="linkDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
    SelectionMode="Single" SelectionChanged="linkDataGrid_SelectionChanged"
    MouseDoubleClick="linkDataGrid_MouseDoubleClick"
    GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="34"
    CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
    AlternatingRowBackground="#F6F9FC">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Link Path" Width="2*" Binding="{Binding Source}"/>
     <DataGridTextColumn Header="Type" Width="*" Binding="{Binding Type}"/>
     <DataGridTextColumn Header="Target Path" Width="2*" Binding="{Binding Target}"/>
     <DataGridCheckBoxColumn Header="Target exists" Width="110" Binding="{Binding Result}"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock Text="Scanning:" Foreground="#637084" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
   <Button x:Name="DeleteLink" DockPanel.Dock="Right" Content="Delete selected link" Click="DeleteLink_Click" IsEnabled="False" Margin="14,0,0,0"/>
   <TextBox x:Name="currentSearchDirectory" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#637084" VerticalContentAlignment="Center"/>
  </DockPanel>
 </Grid>
</Page>